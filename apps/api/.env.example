# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
#   cp apps/api/.env.example apps/api/.env
#
# This is the master-data service: it owns work centers, work units, equipment,
# products and the rest of the ISA-95 hierarchy, and other services read from it
# over HTTP. Everything below is required unless marked optional.

NODE_ENV="development"
PORT="3002"

# --- Database ---
# This service's own store, read-write. It owns its schema; migrations live in
# src/shared/database/migration and are generated from the Drizzle schema.
DATABASE_URL=postgresql://user:password@localhost:5432/mes-master-data
# All optional.
# DATABASE_MAX_CONN=20
# DATABASE_IDLE_TIMEOUT_MS=30000
# DATABASE_CONN_TIMEOUT_MS=5000

# --- OIDC / Keycloak ---
# Inbound requests are verified against this realm's JWKS. OIDC_BASE_URI is the
# only one actually consumed today (as both the issuer and the JWKS base); the
# rest are required by the loader and reserved for the token flows.
OIDC_HOST=https://identity.example.test
OIDC_BASE_URI=https://identity.example.test/realms/your-realm
OIDC_TOKEN_URI=https://identity.example.test/realms/your-realm/protocol/openid-connect/token
OIDC_CLIENT_ID=mes-master-data
OIDC_CLIENT_SECRET=your-client-secret
KEYCLOAK_REALMS=your-realm
# Optional, default 30000.
# KEYCLOAK_TIMEOUT=30000

# --- Inbound token checks (both opt-in, both OFF when unset) ---
#
# This service is the callee for cross-service traffic: mes-oee-monitor calls it
# with a Keycloak client_credentials token to resolve work-unit and work-center
# records. Until these are set, authMw verifies only signature, issuer and
# expiry — meaning ANY token from the realm is accepted, human or machine.
#
# ORDER MATTERS. Keycloak emits `aud: ["account"]` by default, so enabling
# AUTH_AUDIENCE before the realm has an audience protocol-mapper 401s EVERY
# caller, browser sessions included. Add the mapper, verify a real token carries
# the audience, and only then set this. Rollback is unsetting it and restarting.
# AUTH_AUDIENCE=mes-master-data
#
# Comma-separated allowlist of `azp` (the client_id a token was issued to).
# Must name every legitimate caller — the browser-facing BFF client AND each
# calling service's client — or enabling it locks out whichever is omitted.
# AUTH_ALLOWED_AZP=mes-master-data,mes-oee-monitor-svc

# --- Service identity ---
# REGION_CODE is the tenancy discriminator every query filters on, and half of
# the (code, region) uniqueness constraint. A cross-service caller must be on the
# same region to see these rows at all.
REGION_CODE=ap3
# APPLICATION_ALIAS identifies this service in logs and traces.
APPLICATION_ALIAS=mes-master-data

# Optional. Comma-separated; defaults to http://localhost:3000 when unset.
# This is the BFF's origin, not the browser's — the SPA reaches the api through
# the proxy, never directly.
CORS_ALLOWED_ORIGINS=http://localhost:3001
